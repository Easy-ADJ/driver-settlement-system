# 값은 비운 채로 커밋한다. 실제 값은 .env 에만 두고 커밋하지 않는다.

# --- 정산 DB (Supabase, Supavisor session 모드) ---
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# --- 로그인 DB (읽기 전용 계정 settlement_ro). DataSource 등록은 #36 ---
AUTH_DATASOURCE_URL=
AUTH_DATASOURCE_USERNAME=
AUTH_DATASOURCE_PASSWORD=

# --- 서버 간 호출 주소 ---
LEDGER_API_BASE_URL=
PAYMENT_API_BASE_URL=

# --- 배치 실행 시각 (Asia/Seoul). 비우면 매일 새벽 3시 ---
SETTLEMENT_BATCH_CRON=

# --- 서버 포트. 로컬에서는 비워둔다(8080). Railway가 직접 주입한다 ---
PORT=
